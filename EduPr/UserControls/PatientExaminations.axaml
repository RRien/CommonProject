<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EduPr.PatientExaminations">
	<Border Background="#ffffff" Padding="20" BorderBrush="#e0e0e0" BorderThickness="1">
		<StackPanel Spacing="15">
			<TextBlock Text="Результаты обследований" FontSize="18" FontWeight="Bold" Foreground="#e65100" HorizontalAlignment="Center"></TextBlock>
			<DataGrid x:Name="ExaminationsGrid" Height="400" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Дата" Binding="{Binding IdAppointmentNavigation.DateAppointment, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"></DataGridTextColumn>
					<DataGridTextColumn Header="Исследование" Binding="{Binding IdLabResearchNavigation.NameLabResearch}" Width="*"></DataGridTextColumn>
					<DataGridTextColumn Header="Результаты" Binding="{Binding ResultsExam}" Width="*"></DataGridTextColumn>
					<DataGridTextColumn Header="Заключение" Binding="{Binding ConclusionExam}" Width="*"></DataGridTextColumn>
				</DataGrid.Columns>
			</DataGrid>
		</StackPanel>
	</Border>
</UserControl>
