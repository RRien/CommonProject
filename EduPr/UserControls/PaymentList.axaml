<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EduPr.PaymentsList">
	<StackPanel Spacing="15" Margin="20">
		<Border Background="#ffffff" Padding="15" BorderBrush="#e0e0e0" BorderThickness="1 1 1 1">
			<Grid ColumnDefinitions="*,Auto,Auto">
				<TextBox x:Name="searchTb" Watermark="Поиск по фамилии пациента" Background="#f9fafb"  Padding="10" BorderBrush="#bbeaff" TextChanged="Search_TextChanged"></TextBox>
				<ComboBox x:Name="statusFilter" Grid.Column="1" Margin="10 0 0 0" Width="200" SelectionChanged="StatusFilter_Changed">
					<ComboBoxItem Content="Все статусы" IsSelected="True"></ComboBoxItem>
					<ComboBoxItem Content="Не оплачен"></ComboBoxItem>
					<ComboBoxItem Content="Частично оплачен"></ComboBoxItem>
					<ComboBoxItem Content="Оплачен"></ComboBoxItem>
				</ComboBox>

				<Button Grid.Column="2" Content="Найти" Margin="10 0 0 0" Padding="20,5" Background="#fff3e0" Foreground="#e65100" BorderThickness="1 1 1 1" BorderBrush="#e65100" Click="Search_Click"/>
			</Grid>
		</Border>

		<Border Background="#ffffff" Padding="10" BorderBrush="#e0e0e0" BorderThickness="1 1 1 1">
			<DataGrid x:Name="PaymentsGrid"
                      MinHeight="300" MaxHeight="150" IsReadOnly="True" AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal" DoubleTapped="Payment_DoubleTapped">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Дата" Binding="{Binding IssueDateInvoice, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"></DataGridTextColumn>
					<DataGridTextColumn Header="Пациент" Binding="{Binding IdPatientNavigation.LastNamePatient}" Width="*"></DataGridTextColumn>
					<DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmountInvoice, StringFormat=\{0:0.00\} ₽}" Width="100"></DataGridTextColumn>
					<DataGridTextColumn Header="Скидка" Binding="{Binding DiscountInvoice, StringFormat=\{0:0.00\} ₽}" Width="100"></DataGridTextColumn>
					<DataGridTextColumn Header="Итого" Binding="{Binding FinalAmountInvoice, StringFormat=\{0:0.00\} ₽}" Width="100"></DataGridTextColumn>
					<DataGridTextColumn Header="Статус" Binding="{Binding IdPaymentStatusNavigation.NamePaymentStatus}" Width="170"></DataGridTextColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>

		<Button Content="Выставить счёт" HorizontalAlignment="Right" Padding="20,10" FontSize="14" FontWeight="Bold" Background="#e65100" Foreground="#fff3e0" BorderThickness="1 1 1 1" BorderBrush="#e65100" Click="AddPayment_Click"/>
	</StackPanel>
</UserControl>