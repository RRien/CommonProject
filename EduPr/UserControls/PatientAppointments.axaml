<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EduPr.PatientAppointments">
	<Border Background="#ffffff" Padding="20" BorderBrush="#e0e0e0" BorderThickness="1 1 1 1">
		<StackPanel Spacing="15">
			<TextBlock Text="История посещений" FontSize="18" FontWeight="Bold" Foreground="#e65100" HorizontalAlignment="Center"></TextBlock>
			<DataGrid x:Name="AppointmentsGrid" MinHeight="300" MaxHeight="150" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Дата" Binding="{Binding DateAppointment, StringFormat=\{0:dd.MM.yyyy\}}" Width="*"></DataGridTextColumn>
					<DataGridTextColumn Header="Время" Binding="{Binding TimeAppointment, StringFormat=\{0:hh\\:mm\}}" Width="*"></DataGridTextColumn>
					<DataGridTextColumn Header="Врач" Binding="{Binding IdDoctorNavigation.FullName}" Width="*"/>
					<DataGridTextColumn Header="Услуга" Binding="{Binding IdServiceNavigation.NameService}" Width="*"></DataGridTextColumn>
					<DataGridTextColumn Header="Статус" Binding="{Binding IdStatusNavigation.NameStatus}" Width="*"></DataGridTextColumn>
					<DataGridTextColumn Header="Диагноз" Binding="{Binding DiagnosisAppointment}" Width="*"></DataGridTextColumn>
				</DataGrid.Columns>
			</DataGrid>
		</StackPanel>
	</Border>
</UserControl>
