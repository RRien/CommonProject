<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EduPr.PaginationControl">
	<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,15,0,0">
		<Button Content="← Назад" Padding="15,8" Background="#fff3e0" Foreground="#e65100"
                BorderThickness="1" BorderBrush="#e65100" Click="BtnPrevious_Click"/>

		<TextBlock x:Name="PageNumber" Text="Страница 1 из 1"
                   FontSize="14" VerticalAlignment="Center" MinWidth="150"
                   TextAlignment="Center"/>

		<Button Content="Вперед →" Padding="15,8" Background="#e65100" Foreground="White"
                BorderThickness="1" BorderBrush="#e65100" Click="BtnNext_Click"/>
	</StackPanel>
</UserControl>
