<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EduPr.MainWindow"
        Title="EduPr">
	<Grid Background="#f5fff9">
		<StackPanel x:Name="fdg" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Spacing="10" Background="#fcffeb">
			<TextBlock Text="Авторизация"  FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" Margin="0 5 0 0" Foreground="#e65100"></TextBlock>
			<TextBlock Text="Логин:" FontSize="15" Foreground="#bf360c"></TextBlock>
			<TextBox Name="LoginTb" Background="#f5fff9" BorderBrush="#bbeaff"></TextBox>
			<TextBlock Text="Пароль:" FontSize="15" Margin="0 5 0 0"  Foreground="#bf360c"></TextBlock>
			<TextBox Name="PasswordTb" Background="#f5fff9" BorderBrush="#bbeaff"></TextBox>
			<Button Content="Войти" Foreground="#f5fff9"  Background="#e65100" Click="Button_Click" ></Button>
		</StackPanel>
	</Grid>
</Window>
