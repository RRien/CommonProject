<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EduPr.PaymentCard"
        Title="PaymentCard">
	<Border Background="#ffffff" Padding="30" BorderBrush="#e0e0e0" BorderThickness="1 1 1 1">
		<StackPanel Spacing="15" MaxWidth="500" HorizontalAlignment="Center">
			<TextBlock Text="Формирование счёта" FontSize="18" FontWeight="Bold" Foreground="#e65100" HorizontalAlignment="Center" Margin="0 0 0 20"></TextBlock> 
			<Grid ColumnDefinitions="150,*">
				<TextBlock Text="Пациент:" FontWeight="Bold" VerticalAlignment="Center"/>
				<ComboBox Grid.Column="1" x:Name="cmbPatient" DisplayMemberBinding="{Binding LastNamePatient}" PlaceholderText="Выберите пациента" Background="#f9fafb" BorderBrush="#bbeaff" Margin="10 0 0 0"></ComboBox>
			</Grid>

			<Grid ColumnDefinitions="150,*">
				<TextBlock Text="Дата счёта:" FontWeight="Bold" VerticalAlignment="Center"></TextBlock>
				<DatePicker Grid.Column="1" x:Name="dpDate" Width="250" HorizontalAlignment="Left" Background="#f9fafb" BorderBrush="#bbeaff" Margin="10 0 0 0"></DatePicker>
			</Grid>

			<Grid ColumnDefinitions="150,*">
				<TextBlock Text="Общая сумма:" FontWeight="Bold" VerticalAlignment="Center"></TextBlock>
				<NumericUpDown Grid.Column="1" x:Name="numTotal" Minimum="0" FormatString="0.00" Background="#f9fafb" BorderBrush="#bbeaff" Margin="10 0 0 0" ValueChanged="Amount_ValueChanged"></NumericUpDown>
			</Grid>

			<Grid ColumnDefinitions="150,*">
				<TextBlock Text="Скидка:" FontWeight="Bold" VerticalAlignment="Center"></TextBlock>
				<NumericUpDown Grid.Column="1" x:Name="numDiscount" Minimum="0" FormatString="0.00" Background="#f9fafb" BorderBrush="#bbeaff" Margin="10 0 0 0" ValueChanged="Amount_ValueChanged"></NumericUpDown>
			</Grid>

			<Grid ColumnDefinitions="150,*">
				<TextBlock Text="Итого к оплате:" FontWeight="Bold" VerticalAlignment="Center" Foreground="#e65100"></TextBlock>
				<TextBlock Grid.Column="1" x:Name="txtFinal" Text="0.00 ₽" FontSize="16" FontWeight="Bold" Foreground="#e65100" VerticalAlignment="Center" Margin="10 0 0 0"></TextBlock>
			</Grid>

			<Grid ColumnDefinitions="150,*">
				<TextBlock Text="Статус оплаты:" FontWeight="Bold" VerticalAlignment="Center"/>
				<ComboBox Grid.Column="1" x:Name="cmbStatus" PlaceholderText="Выберите статус" Background="#f9fafb" BorderBrush="#bbeaff" Margin="10 0 0 0">
					<ComboBoxItem Content="Не оплачен" IsSelected="True"></ComboBoxItem>
					<ComboBoxItem Content="Частично оплачен"></ComboBoxItem>
					<ComboBoxItem Content="Оплачен"></ComboBoxItem>
				</ComboBox>
			</Grid>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0 30 0 0">
				<Button Content="Отмена" Padding="20,8" Background="#fff3e0" Foreground="#e65100" BorderThickness="1 1 1 1" BorderBrush="#e65100" Click="BtnCancel_Click"/>
				<Button Content="Сохранить" Padding="20,8" Background="#e65100" Foreground="#fff3e0" BorderThickness="1 1 1 1" BorderBrush="#e65100" Click="BtnSave_Click"/>
			</StackPanel>
		</StackPanel>
	</Border>
</Window>
