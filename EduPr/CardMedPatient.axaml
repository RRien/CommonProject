<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EduPr.CardMedPatient"
        Title="CardMedPatient">
	<Grid Background="#f5fff9">
		<Grid.RowDefinitions>
			<RowDefinition Height="50"></RowDefinition>
			<RowDefinition Height="Auto"></RowDefinition>
			<RowDefinition Height="*"></RowDefinition>
		</Grid.RowDefinitions>
		<Border Grid.Row="0" Background="#ffffff" BorderBrush="#e0e0e0" BorderThickness=" 1 1 1 1" >
			<Grid Margin="15 0">
				<TextBlock Text="Частная медицинская клиника" Foreground="#e65100" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
				<Button x:Name="btnLogout" Content="Выйти" HorizontalAlignment="Right"  Background="#fff3e0" Foreground="#e65100" BorderThickness="1 1 1 1" BorderBrush="#e65100" Click="LogButton_Click"></Button>
			</Grid>
		</Border>
		<Border Grid.Row="1" Background="#ffffff" BorderBrush="#e0e0e0" BorderThickness=" 0 0 0 1" >
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" >
				<Button x:Name="btnPersonal" Content="Личные данные" Background="#fff3e0" Foreground="#e65100" Margin="" Padding="16" FontSize="15"  FontWeight="Bold" Click="BtnPersonal_Click"></Button>
				<Button x:Name="btnAppointments" Content="История посещений" Background="#fff3e0" Foreground="#e65100" Margin="" Padding="16" FontSize="15" FontWeight="Bold" Click="BtnAppointments_Click"></Button>
				<Button x:Name="btnPrescriptions" Content="Назначения" Background="#fff3e0" Foreground="#e65100" Margin="" Padding="16" FontSize="15" FontWeight="Bold" Click="BtnPrescriptions_Click"></Button>
				<Button x:Name="btnExaminations" Content="Обследования" Background="#fff3e0" Foreground="#e65100" Margin="" Padding="16" FontSize="15" FontWeight="Bold" Click="BtnExaminations_Click"></Button>
			</StackPanel>
		</Border>
		<Border Grid.Row="2" Margin="20">
			<ContentControl x:Name="MainContentControl"/>
		</Border>
	</Grid>
</Window>
