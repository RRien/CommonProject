<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EduPr.HeadAdvancedAnalytics">
	<StackPanel Spacing="20">
		<TextBlock  Text="Сводная аналитика" FontSize="20" FontWeight="Bold" Foreground="#e65100"></TextBlock>
		<Border Background="#fff3e0" Padding="15" BorderBrush="#e0e0e0" BorderThickness="1 1 1 1">
			<StackPanel Spacing="10">
				<TextBlock Text="Фильтры" FontWeight="Bold" Foreground="#e65100"></TextBlock>
				<Grid ColumnDefinitions="*,*, *, * " ColumnSpacing="5">
					<ComboBox x:Name="CbFilterDoctor" PlaceholderText="Все врачи" Background="#ffffff" BorderBrush="#bbeaff" BorderThickness="1 1 1 1" DisplayMemberBinding="{Binding LastNameDoctor}" SelectionChanged="Filter_SelectionChanged"></ComboBox>
					<ComboBox Grid.Column="1" x:Name="CbFilterSpecialization" PlaceholderText="Все специализации" Background="#ffffff" BorderBrush="#bbeaff" BorderThickness="1 1 1 1"  DisplayMemberBinding="{Binding NameSpecialization}" SelectionChanged="Filter_SelectionChanged"></ComboBox>
					<ComboBox Grid.Column="2" x:Name="CbFilterDepartment" PlaceholderText="Все отделения" Background="#ffffff" BorderBrush="#bbeaff" BorderThickness="1 1 1 1" DisplayMemberBinding="{Binding NameDepartment}" SelectionChanged="Filter_SelectionChanged"></ComboBox>
					<DatePicker Grid.Column="3" x:Name="dpFilterDate"  Background="#ffffff" BorderBrush="#bbeaff" BorderThickness="1 1 1 1"/>
				</Grid>
			</StackPanel>
		</Border>
		<Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="15" RowSpacing="15">
			<Border Grid.Column="0" Grid.Row="0" Background="#e3f2fd" Padding="15" CornerRadius="5">
				<StackPanel Margin="10 0 10 0">
					<TextBlock Text="Выручка за период" FontSize="15" Foreground="#1565c0"></TextBlock>
					<TextBlock x:Name="txtRevenuePeriod" Text="0 ₽" FontSize="30" FontWeight="Bold" Foreground="#0d47a1"></TextBlock>
					<TextBlock x:Name="txtRevenueCompare" Text="" FontSize="15" Foreground="#1565c0"></TextBlock>
				</StackPanel>
			</Border>
			<Border Grid.Column="1" Grid.Row="0" Background="#e8f5e9" Padding="15" CornerRadius="5">
				<StackPanel>
					<TextBlock Text="Средняя длительность приёма" FontSize="14" Foreground="#1565c0"></TextBlock>
					<TextBlock x:Name="txtAvgDuration" Text="0 мин" FontSize="30" FontWeight="Bold" Foreground="#0d47a1"></TextBlock>			
				</StackPanel>
			</Border>
			<Border Grid.Column="2" Grid.Row="0" Background="#fff3e0" Padding="15" CornerRadius="5">
				<StackPanel>
					<TextBlock Text="Доля повторных обращений" FontSize="15" Foreground="#1565c0"></TextBlock>
					<TextBlock x:Name="txtRepeatRate" Text="0%" FontSize="30" FontWeight="Bold" Foreground="#0d47a1"></TextBlock>			
				</StackPanel>
			</Border>
			<Border Grid.Column="0" Grid.Row="1" Background="#f3e5f5" Padding="15" CornerRadius="5">
				<StackPanel Margin="10 0 10 0">
					<TextBlock Text="Самая востребованная услуга" FontSize="13" Foreground="#1565c0"></TextBlock>
					<TextBlock x:Name="txtTopService" Text="-" FontSize="14" FontWeight="Bold" Foreground="#0d47a1"></TextBlock>
					<TextBlock x:Name="txtTopServiceCount" Text="0 приёмов" FontSize="13" Foreground="#1565c0"></TextBlock>
				</StackPanel>
			</Border>
			<Border Grid.Column="1" Grid.Row="1" Background="#e0f2f1" Padding="20" CornerRadius="5">
				<StackPanel>
					<TextBlock Text="Всего приёмов за период" FontSize="15" Foreground="#00695c"/>
					<TextBlock x:Name="txtTotalAppointments" Text="0" FontSize="30" FontWeight="Bold" Foreground="#004d40"/>
				</StackPanel>
			</Border>
		</Grid>
		<Border Background="#ffffff" Padding="10" BorderBrush="#e0e0e0" BorderThickness="1 1 1 1">
			<StackPanel Spacing="10">
				<TextBlock Text="Топ 5 наиболее востребованных услуг" FontSize="15" FontWeight="Bold" Foreground="#e65100"></TextBlock>
				<DataGrid x:Name="GridTopServices" Height="200" IsReadOnly="True" >
					<DataGrid.Columns>
						<DataGridTextColumn Header="Услуга" Binding="{Binding Name}" Width="*"></DataGridTextColumn>
						<DataGridTextColumn Header="Количество приёмов" Binding="{Binding Count}" Width="150"></DataGridTextColumn>
						<DataGridTextColumn Header="Доля" Binding="{Binding Percentage, StringFormat='{}{0:F1}%'}" Width="100"></DataGridTextColumn>
					</DataGrid.Columns>
				</DataGrid>
				
			</StackPanel>
		</Border>
	</StackPanel>
</UserControl>
